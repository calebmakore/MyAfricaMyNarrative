@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="status-page">
    <p class="eyebrow">Error</p>
    <h1>That didn’t work.</h1>
    <p class="hero-copy">Nothing you made has been lost — your sources, words and approvals are saved. Go back and try again; if it keeps happening, try again in a few minutes.</p>
    <div class="inline-actions">
        <a class="button button-primary" asp-controller="Projects" asp-action="Index">Go to My stories</a>
        <a class="button button-quiet" asp-controller="Home" asp-action="Help">Lessons &amp; Help</a>
    </div>
    @if (Model.ShowRequestId) { <p class="field-help">If you report this, quote reference <code>@Model.RequestId</code>.</p> }
</section>
