<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1c1410" />
    <meta name="description" content="Your story. Your voice. Our Africa. A private studio for turning voice notes and photos into short films you direct." />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="My Narrative" />
    <title>@ViewData["Title"] · My Africa, My Narrative</title>
    <link rel="preload" href="~/fonts/jost/Jost-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["StageBar"] is true ? "has-stage-bar" : "")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="My Africa, My Narrative home">
            <span class="brand-mark">@Icons.Emblem</span>
            <span class="brand-copy"><strong>My Africa</strong><span>My Narrative</span></span>
        </a>
        <nav aria-label="Primary navigation">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="nav-link" asp-controller="Projects" asp-action="Index">My stories</a>
            <a class="nav-link" asp-controller="Pilot" asp-action="Index">Insights</a>
            <a class="nav-link" asp-controller="Home" asp-action="Help">Help</a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button" type="submit">Sign out</button></form>
        }
        else
        {
            <a class="nav-link" asp-controller="Home" asp-action="Help">Help</a>
            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
            <a class="nav-cta" asp-controller="Account" asp-action="Register">Start free</a>
        }
        </nav>
    </header>
    <main id="main-content" class="page-shell">@RenderBody()</main>
    <dialog id="help-dialog" class="help-dialog" aria-labelledby="help-dialog-title">
        <div class="help-dialog-header"><span class="help-mark" aria-hidden="true">?</span><h2 id="help-dialog-title">Help</h2><button type="button" class="help-close" data-help-close aria-label="Close help">×</button></div>
        <div id="help-dialog-content" class="help-dialog-content"></div>
        <div class="help-dialog-actions"><a asp-controller="Home" asp-action="Help">Open Lessons &amp; Help</a><button type="button" class="button-primary" data-help-close>Got it</button></div>
    </dialog>
    <footer><strong>Your story. Your voice. Our Africa.</strong><span>Private by default · You own your sources.</span></footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
