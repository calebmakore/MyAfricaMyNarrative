@model StudioViewModel
@{ ViewData["Title"] = $"Make · {Model.Project.Title}"; }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
<header class="page-header"><div><p class="eyebrow">Make</p><h1>Plan with what you have.</h1><p>Declare real people, places, equipment and time. Unavailable resources remain visible and are never silently replaced.</p></div></header>
<nav class="studio-nav" aria-label="Studio stages"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id">Record</a><a asp-action="Shape" asp-route-id="@Model.Project.Id">Shape</a><a class="active" aria-current="page">Make</a><a asp-action="Export" asp-route-id="@Model.Project.Id">Export</a></nav>
<section class="studio-grid"><div class="surface"><p class="eyebrow">Available resources</p><h2>Add a real resource</h2><form asp-action="AddResource" asp-route-id="@Model.Project.Id" method="post"><label>Type<select name="Kind">@foreach (var kind in Enum.GetValues<ResourceKind>()) { <option value="@kind">@kind</option> }</select></label><label>Name<input name="Name" maxlength="120" required /></label><label>Availability or limit<textarea name="Availability" maxlength="300" rows="3"></textarea></label><button class="button-primary" type="submit">Add resource</button></form></div>
<aside class="surface"><p class="eyebrow">Resource check</p><h2>What the plan may use</h2>@if (Model.Project.Resources.Count == 0) { <p>No resources declared. Add at least a phone, a location and available time.</p> } else { <div class="resource-list">@foreach (var item in Model.Project.Resources.OrderBy(x => x.Kind).ThenBy(x => x.Name)) { <article class="resource-card @(item.IsAvailable ? "" : "unavailable")"><p class="eyebrow">@item.Kind</p><h3>@item.Name</h3><p>@item.Availability</p><strong>@(item.IsAvailable ? "Available" : "Unavailable")</strong><form asp-action="ToggleResource" asp-route-id="@Model.Project.Id" method="post"><input type="hidden" name="resourceId" value="@item.Id"/><button type="submit">Mark @(item.IsAvailable ? "unavailable" : "available")</button></form></article> }</div> }</aside></section>
<section class="surface stage-section"><p class="eyebrow">Scene-linked plan</p><h2>Coverage</h2>@if (Model.CurrentRevision is null) { <p>Shape the story before planning coverage.</p> } else { <div class="scene-list">@foreach (var scene in Model.CurrentRevision.Scenes.OrderBy(x => x.Order)) { <article class="scene-card"><h3>@scene.Order. @scene.Title</h3><p>Real uploaded visual selected · original audio range @scene.StartMs–@scene.EndMs ms.</p>@if (Model.Project.Resources.All(x => !x.IsAvailable)) { <p class="notice error">No available production resources. Review constraints before filming.</p> } else { <p>Available resources: @string.Join(", ", Model.Project.Resources.Where(x => x.IsAvailable).Select(x => x.Name))</p> }</article> }</div> }</section>
