@model StudioViewModel
@{ ViewData["Title"] = $"Export · {Model.Project.Title}"; }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
@if (TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> }
<header class="page-header"><div><p class="eyebrow">Export</p><h1>Check it before you make it.</h1><p>Mode: <strong>@Model.AiMode</strong>. Manual work stays manual; missing Live configuration never creates fabricated output.</p></div></header>
<nav class="studio-nav" aria-label="Studio stages"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id">Record</a><a asp-action="Shape" asp-route-id="@Model.Project.Id">Shape</a><a asp-action="Make" asp-route-id="@Model.Project.Id">Make</a><a class="active" aria-current="page">Export</a></nav>
<section class="studio-grid"><div class="surface"><p class="eyebrow">Readiness</p><h2>@(Model.Readiness.CanExportFinal ? "Ready for final export" : Model.Readiness.CanPreview ? "Ready for a labelled preview" : "Needs attention")</h2><ul class="checklist">@if (Model.Readiness.Issues.Count == 0) { <li class="pass">Current revision, sources, permission, timing and duration are ready.</li> } else { @foreach (var issue in Model.Readiness.Issues) { <li>@issue</li> } }</ul><p>Total selected duration: <strong>@(Model.Readiness.DurationMs/1000d) seconds</strong></p><div class="export-actions"><form asp-action="QueueExport" asp-route-id="@Model.Project.Id" method="post"><input type="hidden" name="final" value="false"/><button class="button-primary" type="submit" disabled="@(!Model.Readiness.CanPreview)">Queue preview</button></form><form asp-action="QueueExport" asp-route-id="@Model.Project.Id" method="post"><input type="hidden" name="final" value="true"/><button class="button-primary" type="submit" disabled="@(!Model.Readiness.CanExportFinal)">Queue 1080 × 1920 final</button></form></div></div>
<aside class="surface"><p class="eyebrow">Durable work</p><h2>Export jobs</h2>@if (Model.Jobs.Count == 0) { <p>No exports queued.</p> } else { <div class="job-list">@foreach (var job in Model.Jobs) { <article><strong>@job.Kind</strong><p>@job.State · attempts @job.Attempts</p>@if (!string.IsNullOrWhiteSpace(job.LastFailure)) { <p class="notice error">@job.LastFailure</p> }</article> }</div> }</aside></section>
<section class="surface stage-section"><p class="eyebrow">Private downloads</p><h2>Current artifacts</h2>@if (Model.Artifacts.Count == 0) { <p>No verified files yet. A successful Worker render will appear here.</p> } else { <div class="artifact-list">@foreach (var artifact in Model.Artifacts) { <article><strong>@artifact.Kind</strong><p>@(artifact.ByteLength/1024d/1024d) MiB · @artifact.Sha256[..12]</p><a class="button-primary" asp-action="Download" asp-route-id="@artifact.Id">Download authorised file</a></article> }</div> }</section>
