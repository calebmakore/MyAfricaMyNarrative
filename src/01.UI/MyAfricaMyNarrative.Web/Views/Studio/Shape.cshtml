@model StudioViewModel
@{ ViewData["Title"] = $"Shape · {Model.Project.Title}"; var audio = Model.Project.MediaAssets.Where(x => x.Kind == MediaKind.Audio && x.PermissionStatus == PermissionStatus.Granted).ToList(); var visuals = Model.Project.MediaAssets.Where(x => x.Kind != MediaKind.Audio && x.PermissionStatus == PermissionStatus.Granted).ToList(); }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
@if (TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> }
<header class="page-header"><div><p class="eyebrow">Shape</p><h1>@Model.Project.Title</h1><p>Review what was spoken, confirm real timing, and build scenes from permitted sources.</p></div></header>
<nav class="studio-nav" aria-label="Studio stages"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id">Record</a><a class="active" aria-current="page">Shape</a><a asp-action="Make" asp-route-id="@Model.Project.Id">Make</a><a asp-action="Export" asp-route-id="@Model.Project.Id">Export</a></nav>
<section class="studio-grid">
<div class="surface"><p class="eyebrow">Reviewed source</p><div class="heading-with-help"><h2>Transcript and timing</h2><button type="button" class="help-button" data-help-title="Reviewing words and timing" data-help="Listen to the source and enter the words that were actually spoken. Mark in is where the selected speech begins; mark out is where it ends. Times use milliseconds: 5 seconds is 5000 ms. Save this review before linking it to a scene."><span aria-hidden="true">?</span><span class="visually-hidden">Help with transcript timing</span></button></div>
@if (audio.Count == 0) { <p class="notice">Add permitted audio in Record before reviewing a transcript.</p> }
else { <form asp-action="SaveTranscript" asp-route-id="@Model.Project.Id" method="post"><label for="AssetId">Source audio</label><select id="AssetId" name="AssetId" required>@foreach (var item in audio) { <option value="@item.Id">@item.DisplayName</option> }</select><div class="timing-grid"><label>Mark in (ms)<input name="StartMs" type="number" min="0" max="300000" value="0" required /></label><label>Mark out (ms)<input name="EndMs" type="number" min="1" max="300000" value="20000" required /></label></div><label for="Language">Language</label><input id="Language" name="Language" value="English" maxlength="40" required /><label for="Text">Corrected words actually spoken</label><textarea id="Text" name="Text" maxlength="12000" rows="7" required></textarea><p class="field-help">Saving creates an immutable reviewed revision. It does not alter the recording.</p><button class="button-primary" type="submit">Save reviewed transcript</button></form> }
@if (Model.Project.TranscriptRevisions.Count > 0) { <h3>Reviewed revisions</h3><ol class="revision-list">@foreach (var transcript in Model.Project.TranscriptRevisions.OrderByDescending(x => x.CreatedAtUtc)) { <li><strong>@transcript.Language</strong> · @transcript.StartMs–@transcript.EndMs ms<blockquote>@transcript.Text</blockquote><audio controls preload="metadata" src="@Url.Action("Play", "Media", new { id = transcript.AssetId })#t=@(transcript.StartMs/1000d),@(transcript.EndMs/1000d)"></audio></li> }</ol> }
</div>
<aside class="surface"><p class="eyebrow">Story revision</p><div class="heading-with-help"><h2>Add a source-backed scene</h2><button type="button" class="help-button" data-help-title="Building a scene" data-help="A scene combines permitted original audio, a real uploaded image or video, an exact source range and caption text. Select the reviewed transcript when quoting the recording. Every save creates a new revision so approved source material is protected."><span aria-hidden="true">?</span><span class="visually-hidden">Help with building a scene</span></button></div>
@if (audio.Count == 0 || visuals.Count == 0) { <p class="notice">A scene needs both permitted audio and a real uploaded image/video. Add the missing source in Record.</p> }
else { <form asp-action="AddScene" asp-route-id="@Model.Project.Id" method="post"><label>Scene title<input name="Title" maxlength="120" required /></label><label>Audio source<select name="AudioAssetId" required>@foreach (var item in audio) { <option value="@item.Id">@item.DisplayName</option> }</select></label><label>Visual source<select name="VisualAssetId" required>@foreach (var item in visuals) { <option value="@item.Id">@item.DisplayName</option> }</select></label><label>Reviewed transcript<select name="TranscriptRevisionId"><option value="">Creator-written text (no quotation)</option>@foreach (var item in Model.Project.TranscriptRevisions.OrderByDescending(x => x.CreatedAtUtc)) { <option value="@item.Id">@item.Language · @item.StartMs–@item.EndMs ms</option> }</select></label><label>Wording origin<select name="TextOrigin"><option value="0">From your recording</option><option value="1">Written by you</option></select></label><div class="timing-grid"><label>Mark in (ms)<input name="StartMs" type="number" min="0" value="0" required /></label><label>Mark out (ms)<input name="EndMs" type="number" min="1" value="20000" required /></label></div><label>Scene text<textarea name="Text" maxlength="4000" rows="4"></textarea></label><label>Caption text<textarea name="Caption" maxlength="2000" rows="3"></textarea></label><button class="button-primary" type="submit">Save as new story revision</button></form> }
</aside></section>
<section class="surface stage-section"><div class="section-heading"><div><p class="eyebrow">Current cut</p><div class="heading-with-help"><h2>Revision @(Model.CurrentRevision?.RevisionNumber.ToString() ?? "—")</h2><button type="button" class="help-button" data-help-title="Approving a revision" data-help="Review scene order, words, captions and timing. Approval locks readiness to this exact revision. If you change a scene later, approve the new revision before exporting again."><span aria-hidden="true">?</span><span class="visually-hidden">Help with story approval</span></button></div></div>@if (Model.CurrentRevision is not null) { <code class="snapshot-hash">@Model.CurrentRevision.SnapshotHash[..12]</code> }</div>
@if (Model.CurrentRevision is null || Model.CurrentRevision.Scenes.Count == 0) { <p>No scenes yet.</p> } else { <div class="scene-list">@foreach (var scene in Model.CurrentRevision.Scenes.OrderBy(x => x.Order)) { <article class="scene-card"><p class="eyebrow">Scene @scene.Order · @scene.TextOrigin</p><h3>@scene.Title</h3><p>@scene.StartMs–@scene.EndMs ms · @((scene.EndMs-scene.StartMs)/1000d)s</p><p>@scene.Text</p><p><strong>Caption:</strong> @scene.Caption</p><div class="scene-actions"><form asp-action="MoveScene" asp-route-id="@Model.Project.Id" method="post"><input type="hidden" name="sceneId" value="@scene.Id"/><button name="direction" value="-1" type="submit" aria-label="Move @scene.Title earlier">Move earlier</button><button name="direction" value="1" type="submit" aria-label="Move @scene.Title later">Move later</button></form></div></article> }</div><form asp-action="Approve" asp-route-id="@Model.Project.Id" method="post"><button class="button-primary" type="submit">Approve this exact revision</button></form> }
</section>
