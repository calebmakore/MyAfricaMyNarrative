@{ ViewData["Title"] = "Check your email"; var minutes = ViewData["LinkMinutes"]; }
<section class="auth-card"><div class="auth-intro"><span class="auth-symbol">@Icons.Emblem</span><p class="eyebrow">Password help</p><h1>Check your email</h1><p>Your private studio stays locked until you choose a new password.</p></div>
<div class="auth-message" role="status"><p>If an account uses that email, a reset link is on its way. The link works once and expires in @minutes minutes.</p><p>No email after a few minutes? Check your spam folder, then <a asp-action="ForgotPassword">ask for another link</a>.</p>
@if (ViewData["PickupMode"] is true) { <p class="notice">Development: emails are not sent. They are saved as <code>.eml</code> files in the configured <code>Email:PickupDirectory</code> (default <code>App_Data/mail-outbox</code>).</p> }
</div><p class="auth-switch"><a asp-action="Login">Back to sign in</a></p></section>
