@{ ViewData["Title"] = "Password changed"; }
<section class="auth-card"><div class="auth-intro"><span class="auth-symbol">@Icons.Emblem</span><p class="eyebrow">Password help</p><h1>Password changed</h1><p>Your private studio is ready when you are.</p></div>
<div class="auth-message" role="status"><p>Your new password is saved. Anywhere else you were signed in is signed out within a few minutes.</p><p><a class="button-primary" asp-action="Login">Sign in <span aria-hidden="true">→</span></a></p></div></section>
