@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<section class="auth-card"><div class="auth-intro"><span class="auth-symbol">@Icons.Emblem</span><p class="eyebrow">Password help</p><h1>Reset your password</h1><p>Enter the email you signed up with. We will send a link to choose a new password.</p></div>
<form method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span><button class="button-primary" type="submit">Send reset link <span aria-hidden="true">→</span></button></form><p class="auth-switch">Remembered it? <a asp-action="Login">Sign in</a></p></section>
