@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth-card"><p class="eyebrow">Welcome back</p><h1>Sign in</h1>
<form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span><button class="button-primary" type="submit">Sign in</button></form><p><a asp-action="Register">Create a creator account</a></p></section>
