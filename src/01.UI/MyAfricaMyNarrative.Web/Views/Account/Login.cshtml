@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth-card"><div class="auth-intro"><span class="auth-symbol">@Icons.Emblem</span><p class="eyebrow">Welcome back</p><h1>Continue your story</h1><p>Your private studio is ready when you are.</p></div>
<form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span><a class="auth-forgot" asp-action="ForgotPassword">Forgot your password?</a><button class="button-primary" type="submit">Sign in <span aria-hidden="true">→</span></button></form><p class="auth-switch">New here? <a asp-action="Register">Create a creator account</a></p></section>
