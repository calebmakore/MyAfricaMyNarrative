@{ ViewData["Title"] = "Reset link not valid"; }
<section class="auth-card"><div class="auth-intro"><span class="auth-symbol">@Icons.Emblem</span><p class="eyebrow">Password help</p><h1>This link has expired</h1><p>Reset links work once and only for a limited time.</p></div>
<div class="auth-message" role="alert"><p>This reset link is invalid, already used or expired. Your password has not changed.</p><p><a class="button-primary" asp-action="ForgotPassword">Request a new link</a></p></div></section>
