@model ResetPasswordViewModel
@{ ViewData["Title"] = "Choose a new password"; }
<section class="auth-card"><div class="auth-intro"><span class="auth-symbol">@Icons.Emblem</span><p class="eyebrow">Password help</p><h1>Choose a new password</h1><p>Use at least 10 characters, including an upper-case letter, a lower-case letter and a number. Your projects and sources are unchanged.</p></div>
<form method="post"><input asp-for="UserId" type="hidden" /><input asp-for="Code" type="hidden" /><div asp-validation-summary="ModelOnly"></div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><button class="button-primary" type="submit">Save new password <span aria-hidden="true">→</span></button></form></section>
