@model IReadOnlyList<Project>
@{ ViewData["Title"] = "Projects"; }
<header class="dashboard-hero"><div><p class="eyebrow">Your private documentary studio</p><h1>Stories shaped<br /><span>in your voice.</span></h1><p class="hero-copy">Bring together original recordings, images and lived experience. You stay in control from first source to final film.</p></div><div class="hero-badge" aria-hidden="true"><span>Record</span><span>Shape</span><span>Make</span><span>Export</span></div></header>
<section class="surface start-card"><div><p class="eyebrow">Begin a new story</p><h2>Start a documentary</h2><p>Give it a working title. You can refine it as the story takes shape.</p></div><form asp-action="Create" method="post"><label for="Title">Project title</label><div class="inline-form"><input id="Title" name="Title" maxlength="120" placeholder="e.g. The hands that taught me" required /><button class="button-primary" type="submit">Start project <span aria-hidden="true">→</span></button></div></form></section>
<section><h2>Your projects</h2>@if (Model.Count == 0) { <div class="empty-state"><h3>No stories here yet</h3><p>Give your first documentary a working title. You can change it later.</p></div> } else { <div class="card-grid">@foreach (var item in Model) { <article class="project-card"><p class="status">@(item.IsArchived ? "Archived" : "Private")</p><h3><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h3><p>Updated @item.UpdatedAtUtc.ToString("d MMM yyyy")</p></article> }</div> }</section>
