@model Project
@{ ViewData["Title"] = Model.Title; }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
@if (TempData["Notice"] is string notice) { <div class="notice success" role="status">@notice <a asp-controller="Studio" asp-action="Shape" asp-route-id="@Model.Id">Continue to Shape</a></div> }
<header class="page-header"><div><p class="eyebrow">Private project</p><h1>@Model.Title</h1></div><form asp-action="Rename" asp-route-id="@Model.Id" method="post" class="inline-form"><label class="visually-hidden" for="Title">New title</label><input id="Title" name="Title" value="@Model.Title" maxlength="120" required /><button type="submit">Rename</button></form></header>
<nav class="studio-nav" aria-label="Studio stages"><a class="active" href="#record">Record</a><a asp-controller="Studio" asp-action="Shape" asp-route-id="@Model.Id">Shape</a><a asp-controller="Studio" asp-action="Make" asp-route-id="@Model.Id">Make</a><a asp-controller="Studio" asp-action="Export" asp-route-id="@Model.Id">Export</a></nav>
<section id="record" class="studio-grid"><div class="surface"><p class="eyebrow">Record</p><div class="heading-with-help"><h2>Add an original source</h2><button type="button" class="help-button" data-help-title="Adding a source" data-help="A source is an original recording, photo or video used in your documentary. Record with this device or upload a supported file, confirm permission, and save it privately. Audio is needed for spoken story scenes; an image or video is needed for the picture."><span aria-hidden="true">?</span><span class="visually-hidden">Help with adding a source</span></button></div><p>JPEG, PNG, WebP, MP3, WAV, MP4/M4A, WebM or WebA. Up to 20 MiB each.</p>
<form id="source-upload-form" asp-controller="Media" asp-action="Upload" asp-route-projectId="@Model.Id" method="post" enctype="multipart/form-data"><label for="DisplayName">Source name</label><input id="DisplayName" name="DisplayName" maxlength="120" placeholder="e.g. Grandmother's kitchen interview" required /><p class="field-help">Use a short name you will recognise when building scenes.</p><label for="File">Source file</label><input id="File" name="File" type="file" accept="image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,audio/mp4,video/mp4,video/webm,audio/webm,audio/weba,.weba" required /><label for="Attribution">Attribution (optional)</label><input id="Attribution" name="Attribution" maxlength="300" /><label class="check"><input id="PermissionConfirmed" name="PermissionConfirmed" type="checkbox" value="true" required /> I confirm I have permission to use this source. This is an owner attestation, not independent verification.</label><button class="button-primary" type="submit">Upload privately</button></form>
<details><summary>Record with this device</summary><div id="recording-indicator" class="recording-indicator" aria-live="polite"><span class="recording-dot" aria-hidden="true"></span><span id="recording-state">Ready to record</span><strong id="recording-time">00:00</strong></div><p id="recording-status" role="status">Recording needs a compatible secure browser and microphone permission. If unavailable or refused, use the file upload above.</p><div class="recording-controls"><button type="button" id="start-recording">Start microphone</button><button type="button" id="stop-recording" disabled>Stop and review</button></div><div id="recording-review" class="recording-review" hidden><audio id="recording-preview" controls></audio><label for="RecordingDisplayName">Recording name</label><input id="RecordingDisplayName" maxlength="120" placeholder="e.g. My childhood memory" required /><label class="check"><input id="RecordingPermissionConfirmed" type="checkbox" /> I confirm I have permission to use this recording. This is an owner attestation.</label><button class="button-primary" type="button" id="save-recording">Save recording to Sources</button></div></details></div>
<aside id="sources" class="surface"><div class="section-heading"><h2>Sources</h2>@if (Model.MediaAssets.Any(x => x.PermissionStatus == PermissionStatus.Granted && x.Kind == MediaKind.Audio)) { <a class="button-primary" asp-controller="Studio" asp-action="Shape" asp-route-id="@Model.Id">Continue to Shape</a> }</div>@if (Model.MediaAssets.Count == 0) { <p>No sources uploaded yet. Record or upload one to begin Shape.</p> } else { <div class="source-list">@foreach (var asset in Model.MediaAssets) { <article><h3>@asset.DisplayName</h3><p class="field-help">Original file: @asset.OriginalName</p><p>@asset.Kind · @((asset.ByteLength / 1024d / 1024d).ToString("0.0")) MiB</p><p>@asset.PermissionDeclaration: <strong>@asset.PermissionStatus</strong></p><form class="source-rename" asp-controller="Media" asp-action="Rename" asp-route-projectId="@Model.Id" asp-route-id="@asset.Id" method="post"><label class="visually-hidden" for="source-name-@asset.Id">Rename @asset.DisplayName</label><input id="source-name-@asset.Id" name="DisplayName" value="@asset.DisplayName" maxlength="120" required /><button type="submit">Rename</button></form>@if (asset.PermissionStatus == PermissionStatus.Granted) { @if (asset.Kind == MediaKind.Image) { <img src="@Url.Action("Play", "Media", new { id = asset.Id })" alt="Uploaded source @asset.DisplayName" /> } else if (asset.Kind == MediaKind.Audio) { <audio controls preload="metadata" src="@Url.Action("Play", "Media", new { id = asset.Id })"></audio> } else { <video controls preload="metadata" src="@Url.Action("Play", "Media", new { id = asset.Id })"></video> }<form asp-controller="Media" asp-action="Withdraw" asp-route-projectId="@Model.Id" asp-route-id="@asset.Id" method="post"><button class="button-danger" type="submit">Withdraw permission</button></form> }</article> }</div> }</aside></section>
<div class="project-actions"><form asp-action="Archive" asp-route-id="@Model.Id" method="post"><button type="submit">@(Model.IsArchived ? "Restore project" : "Archive project")</button></form><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this project and its database records?');"><button class="button-danger" type="submit">Delete project</button></form></div>
