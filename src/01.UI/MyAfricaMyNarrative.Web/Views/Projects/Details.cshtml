@model Project
@{ ViewData["Title"] = Model.Title; }
@if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
<header class="page-header"><div><p class="eyebrow">Private project</p><h1>@Model.Title</h1></div><form asp-action="Rename" asp-route-id="@Model.Id" method="post" class="inline-form"><label class="visually-hidden" for="Title">New title</label><input id="Title" name="Title" value="@Model.Title" maxlength="120" required /><button type="submit">Rename</button></form></header>
<nav class="studio-nav" aria-label="Studio stages"><a class="active" href="#record">Record</a><span aria-disabled="true" title="Add and review sources first">Shape</span><span aria-disabled="true" title="Shape the story first">Make</span><span aria-disabled="true" title="Approve a complete story first">Export</span></nav>
<section id="record" class="studio-grid"><div class="surface"><p class="eyebrow">Record</p><h2>Add an original source</h2><p>JPEG, PNG, WebP, MP3, WAV, MP4/M4A or WebM. Up to 20 MiB each.</p>
<form asp-controller="Media" asp-action="Upload" asp-route-projectId="@Model.Id" method="post" enctype="multipart/form-data"><label for="File">Source file</label><input id="File" name="File" type="file" accept="image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,audio/mp4,video/mp4,video/webm,audio/webm" required /><label for="Attribution">Attribution (optional)</label><input id="Attribution" name="Attribution" maxlength="300" /><label class="check"><input name="PermissionConfirmed" type="checkbox" value="true" required /> I confirm I have permission to use this source. This is an owner attestation, not independent verification.</label><button class="button-primary" type="submit">Upload privately</button></form>
<details><summary>Record with this device</summary><p id="recording-status">Recording needs a compatible secure browser and microphone permission. If unavailable or refused, use the file upload above.</p><button type="button" id="start-recording">Start microphone</button><button type="button" id="stop-recording" disabled>Stop and review</button><audio id="recording-preview" controls hidden></audio></details></div>
<aside class="surface"><h2>Sources</h2>@if (Model.MediaAssets.Count == 0) { <p>No sources uploaded yet.</p> } else { <div class="source-list">@foreach (var asset in Model.MediaAssets) { <article><h3>@asset.OriginalName</h3><p>@asset.Kind · @((asset.ByteLength / 1024d / 1024d).ToString("0.0")) MiB</p><p>@asset.PermissionDeclaration: <strong>@asset.PermissionStatus</strong></p>@if (asset.PermissionStatus == PermissionStatus.Granted) { @if (asset.Kind == MediaKind.Image) { <img src="@Url.Action("Play", "Media", new { id = asset.Id })" alt="Uploaded source @asset.OriginalName" /> } else if (asset.Kind == MediaKind.Audio) { <audio controls preload="metadata" src="@Url.Action("Play", "Media", new { id = asset.Id })"></audio> } else { <video controls preload="metadata" src="@Url.Action("Play", "Media", new { id = asset.Id })"></video> }<form asp-controller="Media" asp-action="Withdraw" asp-route-projectId="@Model.Id" asp-route-id="@asset.Id" method="post"><button class="button-danger" type="submit">Withdraw permission</button></form> }</article> }</div> }</aside></section>
<div class="project-actions"><form asp-action="Archive" asp-route-id="@Model.Id" method="post"><button type="submit">@(Model.IsArchived ? "Restore project" : "Archive project")</button></form><form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this project and its database records?');"><button class="button-danger" type="submit">Delete project</button></form></div>
